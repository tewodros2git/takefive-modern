---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<Layout
  title={`${service.title} | Take Five Events`}
  description={service.summary}
>
  <section class="bg-brand-dark py-20 text-center text-white">
    <div class="mx-auto max-w-3xl px-4">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand">Services</p>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">{service.title}</h1>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16">
    <p class="text-lg text-neutral-700">{service.description}</p>

    <div class="mt-10 rounded-lg border border-neutral-200 bg-neutral-50 p-6 text-center">
      <h2 class="text-lg font-semibold text-neutral-900">Ready to plan your event?</h2>
      <p class="mt-2 text-sm text-neutral-600">Get in touch and we'll help you bring it to life.</p>
      <a
        href="/#contact"
        class="mt-4 inline-flex items-center rounded-md bg-brand px-6 py-3 text-sm font-semibold text-brand-dark hover:bg-brand/90"
      >
        Contact Us
      </a>
    </div>

    <a href="/services/" class="mt-8 inline-block text-sm font-semibold text-brand hover:underline">
      ← Back to all services
    </a>
  </section>
</Layout>
