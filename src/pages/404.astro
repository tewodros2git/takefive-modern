---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found | Take Five Events"
  description="The page you are looking for could not be found."
>
  <section class="mx-auto max-w-2xl px-4 py-32 text-center">
    <h1 class="text-4xl font-bold text-neutral-900">404</h1>
    <p class="mt-4 text-neutral-600">Sorry, the page you're looking for doesn't exist.</p>
    <a href="/" class="mt-8 inline-flex items-center rounded-md bg-brand px-6 py-3 text-sm font-semibold text-brand-dark hover:bg-brand/90">
      Back to home
    </a>
  </section>
</Layout>
