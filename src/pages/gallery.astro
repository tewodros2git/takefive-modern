---
import Layout from '../layouts/Layout.astro';

interface GalleryImage {
  src: string;
  alt: string;
}

// TODO: replace with the real set of event photos migrated from the WordPress media library.
const images: GalleryImage[] = [];
---

<Layout
  title="Gallery | Take Five Events"
  description="A look at events managed by Take Five Conference and Event across Ethiopia."
>
  <section class="bg-neutral-950 py-20 text-center text-white">
    <div class="mx-auto max-w-3xl px-4">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand">Gallery</p>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">Moments from our events</h1>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    {images.length === 0 ? (
      <p class="text-center text-sm text-neutral-500">
        Gallery photos are being migrated from the previous site. Check back soon.
      </p>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {images.map((image) => (
          <img src={image.src} alt={image.alt} class="aspect-[4/3] w-full rounded-lg object-cover" loading="lazy" />
        ))}
      </div>
    )}
  </section>
</Layout>
