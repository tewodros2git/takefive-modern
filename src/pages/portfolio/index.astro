---
import Layout from '../../layouts/Layout.astro';
import { portfolioCategories, portfolioItems } from '../../data/portfolio';
---

<Layout
  title="Portfolio | Take Five Events"
  description="Take Five Conference and Event Organizer has delivered more than 100 high-profile events across Ethiopia and Africa, from African Union summits to state ceremonies and international conferences."
>
  <section class="bg-brand-dark py-20 text-center text-white">
    <div class="mx-auto max-w-3xl px-4">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand">Portfolio</p>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">What We at Take Five do for our Clients</h1>
      <p class="mt-4 text-neutral-300">
        We are passionate about embracing challenges and transforming them into opportunities, driving
        innovation in the event and conference sector.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="flex flex-wrap justify-center gap-2" id="filter-tabs">
      {portfolioCategories.map((category, i) => (
        <button
          type="button"
          data-category={category}
          class:list={[
            'rounded-full border px-4 py-2 text-sm font-medium transition',
            i === 0
              ? 'border-brand-dark bg-brand-dark text-white'
              : 'border-neutral-300 text-neutral-700 hover:border-brand hover:text-brand-dark',
          ]}
        >
          {category}
        </button>
      ))}
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="portfolio-grid">
      {portfolioItems.map((item) => (
        <a
          href={`/portfolio/${item.slug}/`}
          class="portfolio-card group overflow-hidden rounded-lg border border-neutral-200 transition hover:border-brand hover:shadow-md"
          data-categories={item.categories.join('|')}
        >
          <div class="flex h-40 items-center justify-center bg-neutral-100 text-brand-dark/30">
            <span class="material-symbols-outlined text-5xl" aria-hidden="true">military_tech</span>
          </div>
          <div class="p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-dark/70">{item.categories[0]}</p>
            <h2 class="mt-1 font-semibold text-neutral-900 group-hover:text-brand-dark">{item.title}</h2>
          </div>
        </a>
      ))}
    </div>

    <p class="mx-auto mt-12 max-w-3xl text-center text-sm text-neutral-600">
      Take Five Conference and Event Organizer has delivered more than 100 high-profile events across
      Ethiopia and Africa, ranging from international summits and state ceremonies to corporate
      gatherings, exhibitions, and cultural showcases. Each project reflects our commitment to
      precision, creativity, and professionalism.
    </p>
    <p class="mx-auto mt-4 max-w-3xl text-center text-sm text-neutral-600">
      Our portfolio highlights include African Union General Assemblies, UN and WHO regional
      conferences, state ceremonies such as the funeral of Prime Minister Meles Zenawi, and
      international platforms like ICASA and Origin Africa Fashion Week. Whether coordinating
      high-level diplomatic meetings or producing vibrant cultural festivals, we consistently deliver
      seamless execution and unforgettable experiences.
    </p>
  </section>
</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('#filter-tabs button');
  const cards = document.querySelectorAll<HTMLAnchorElement>('.portfolio-card');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const category = tab.dataset.category;
      tabs.forEach((t) => {
        t.classList.remove('bg-brand-dark', 'text-white', 'border-brand-dark');
        t.classList.add('border-neutral-300', 'text-neutral-700');
      });
      tab.classList.add('bg-brand-dark', 'text-white', 'border-brand-dark');
      tab.classList.remove('border-neutral-300', 'text-neutral-700');

      cards.forEach((card) => {
        const categories = card.dataset.categories?.split('|') ?? [];
        const show = category === 'All' || categories.includes(category ?? '');
        card.style.display = show ? '' : 'none';
      });
    });
  });
</script>
